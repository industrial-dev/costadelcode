---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityMosaicSection from '../../components/CommunityMosaicSection.astro';
import JoinCta from '../../components/JoinCta.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CommunityWhySection from '../../components/CommunityWhySection.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SetupCard from '../../components/SetupCard.astro';
import CommunityResourcesSection from '../../components/CommunityResourcesSection.astro';
import { siteContentByLocale } from '../../data/site-content';
import { pagePaths } from '../../data/i18n';
import CommunityTerminal from '../../components/CommunityTerminal';

const content = siteContentByLocale.en;
const { shared, pages } = content;
const community = pages.community;
const locale = 'en' as const;
---

<BaseLayout
  title={community.meta.title}
  description={community.meta.description}
  canonicalPath={pagePaths.community}
  locale={locale}
  pageKey="community"
>
  <SiteHeader
    brand={shared.brand}
    nav={shared.nav}
    ctas={shared.ctaLinks}
    menuLabel={shared.labels.menu}
    navigationLabel={shared.labels.navigation}
    locale={locale}
    pageKey="community"
    languageLabel="Language"
  />

  <main class="relative">
    <section class="section pt-12">
      <div class="shell">
        <div class="flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
          <div class="flex-1">
            <p class="eyebrow">{community.hero.eyebrow}</p>
            <h1 class="title-xl mt-6">{community.hero.title}</h1>
            <p class="mt-6 text-xl leading-8 text-ink-800 md:text-2xl">
              {community.hero.intro}
            </p>
            <div class="body-copy mt-6 space-y-1">
              {
                community.hero.description.map((paragraph) => (
                  <p>{paragraph}</p>
                ))
              }
            </div>
          </div>
          <div class="w-full shrink-0 md:w-120">
            <CommunityTerminal
              client:visible
              command="$ npx create-costadelcode"
              steps={[
                {
                  text: '\n  ⠿ Scanning the Costa del Sol for developers...',
                },
                { text: '\n  ✓ Found 4,251 developers' },
                {
                  text: '\n  ✓ Finding a spot with a terrace and great WiFi...',
                },
                { text: '\n  ✓ Installing dependencies cervezas@^1.0.0' },
                {
                  text: '\n  ✓ Setting up the community Telegram and Instagram channels...',
                },
                { text: '\n  ✓ Syncing ideas...' },
                { text: '\n' },
                {
                  text: '\n  🚀 Pushing to production. Community is ready.',
                  bold: true,
                },
              ]}
              pulseInterval={55}
              ariaLabel="Terminal animation"
              stepInterval={1200}
            />
          </div>
        </div>
      </div>
    </section>

    <CommunityMosaicSection founderCard={community.founderCard} />

    <CommunityWhySection purpose={community.purpose} />

    <CommunityResourcesSection locale={locale} />

    <section class="section section-border">
      <div class="shell space-y-10">
        <SectionHeading
          eyebrow={community.setups.eyebrow}
          title={community.setups.title}
        />
        <div class="grid gap-6 lg:grid-cols-2">
          {community.setups.items.map((setup) => <SetupCard setup={setup} />)}
        </div>
      </div>
    </section>

    <JoinCta join={shared.join} links={shared.ctaLinks} />
  </main>

  <SiteFooter
    brand={shared.brand}
    tagline={shared.tagline}
    nav={shared.nav}
    social={shared.social}
    footer={shared.footer}
  />
</BaseLayout>
