---
import HomeEventSection from '../../components/HomeEventSection.astro';
import HomeHeroSection from '../../components/HomeHeroSection.astro';
import HomePillarsSection from '../../components/HomePillarsSection.astro';
import CommunityOriginSection from '../../components/CommunityOriginSection.astro';
import JoinCta from '../../components/JoinCta.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pagePaths } from '../../data/i18n';
import { siteContentByLocale } from '../../data/site-content';

const { shared, pages } = siteContentByLocale.en;
const home = pages.home;
const community = pages.community;
const locale = 'en' as const;
---

<BaseLayout
  title={home.meta.title}
  description={home.meta.description}
  canonicalPath={pagePaths.home}
  locale={locale}
  pageKey="home"
  showIntro={true}
>
  <SiteHeader
    brand={shared.brand}
    nav={shared.nav}
    ctas={shared.ctaLinks}
    menuLabel={shared.labels.menu}
    navigationLabel={shared.labels.navigation}
    locale={locale}
    pageKey="home"
    languageLabel="Language"
  />

  <main class="relative">
    <HomeHeroSection hero={home.hero} locale={locale} />
    <HomePillarsSection pillars={home.pillars} />
    {
      community.origin && (
        <CommunityOriginSection origin={community.origin} locale={locale} />
      )
    }
    <HomeEventSection
      eventHighlight={home.eventHighlight}
      labels={shared.labels}
    />
    <JoinCta join={shared.join} links={shared.ctaLinks} />
  </main>

  <SiteFooter
    brand={shared.brand}
    tagline={shared.tagline}
    nav={shared.nav}
    social={shared.social}
    footer={shared.footer}
  />
</BaseLayout>
