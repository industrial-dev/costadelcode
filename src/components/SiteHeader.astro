---
import type { CtaLink, NavItem } from '../data/site-content';
import CtaButton from './CtaButton.astro';
import BrandLogo from './BrandLogo.astro';
import { withBasePath } from '../utils/paths';
import homeIcon from '../assets/icons/nav/home.svg?raw';
import communityIcon from '../assets/icons/nav/community.svg?raw';
import eventsIcon from '../assets/icons/nav/events.svg?raw';
import faqIcon from '../assets/icons/nav/faq.svg?raw';
import { localizedPath, type Locale, type PageKey } from '../data/i18n';

interface Props {
  brand: string;
  nav: NavItem[];
  ctas: CtaLink[];
  menuLabel: string;
  navigationLabel: string;
  locale: Locale;
  pageKey: PageKey;
  languageLabel: string;
}

const {
  brand,
  nav,
  ctas,
  menuLabel,
  navigationLabel,
  locale,
  pageKey,
  languageLabel,
} = Astro.props as Props;
const languages = [
  { code: 'es' as const, label: 'ES' },
  { code: 'en' as const, label: 'EN' },
];
const pageKeyFromHref = (href: string): PageKey => {
  if (href.includes('community')) return 'community';
  if (href.includes('events')) return 'events';
  if (href.includes('faq')) return 'faq';
  return 'home';
};
const homeHref = withBasePath(localizedPath(locale, 'home'));

const navIcons: Record<string, string> = {
  '/': homeIcon,
  '/community/': communityIcon,
  '/events/': eventsIcon,
  '/faq/': faqIcon,
};
---

<header
  class="site-header sticky top-0 z-40 border-b border-(--border-soft) bg-[rgb(246_241_232/0.92)] backdrop-blur-[18px]"
>
  <nav
    class="shell flex min-h-19 items-center justify-between gap-4"
    aria-label={navigationLabel}
  >
    <a
      href={homeHref}
      class="font-logo text-[clamp(1.15rem,0.92rem+0.7vw,1.7rem)] leading-none font-bold tracking-[-0.2em] whitespace-nowrap uppercase text-ink-950 [word-spacing:0.08em]"
      aria-label={brand}
    >
      <BrandLogo brand={brand} />
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {
        nav.map((item) => (
          <a
            href={withBasePath(
              localizedPath(locale, pageKeyFromHref(item.href))
            )}
            class="nav-link flex items-center gap-1.5"
          >
            <Fragment set:html={navIcons[item.href] ?? ''} />
            {item.label}
          </a>
        ))
      }
      <span class="h-5 w-px bg-stone-300" aria-hidden="true"></span>
      <div
        class="flex items-center gap-1"
        role="group"
        aria-label={languageLabel}
      >
        {
          languages.map((language) => (
            <a
              href={withBasePath(localizedPath(language.code, pageKey))}
              lang={language.code}
              hreflang={language.code}
              aria-label={language.code === 'es' ? 'Español' : 'English'}
              aria-current={language.code === locale ? 'page' : undefined}
              class:list={[
                'rounded-md px-1.5 py-1 text-xs font-bold',
                language.code === locale
                  ? 'text-ink-950'
                  : 'text-stone-500 hover:text-ink-950',
              ]}
            >
              {language.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hidden items-center gap-2 md:flex">
      {ctas.map((cta) => <CtaButton link={cta} />)}
    </div>

    <details class="relative md:hidden">
      <summary class="button button-ghost px-4 py-2">{menuLabel}</summary>
      <div class="menu-panel">
        <div class="grid gap-3">
          {
            nav.map((item) => (
              <a
                href={withBasePath(
                  localizedPath(locale, pageKeyFromHref(item.href))
                )}
                class="menu-link flex items-center gap-2"
              >
                <Fragment set:html={navIcons[item.href] ?? ''} />
                {item.label}
              </a>
            ))
          }
          {ctas.map((cta) => <CtaButton link={cta} class="w-full" />)}
          <div class="mt-1 border-t border-(--border-soft) pt-3">
            <p
              class="mb-2 text-xs font-semibold uppercase tracking-wider text-stone-500"
            >
              {languageLabel}
            </p>
            <div class="flex gap-2">
              {
                languages.map((language) => (
                  <a
                    href={withBasePath(localizedPath(language.code, pageKey))}
                    lang={language.code}
                    hreflang={language.code}
                    aria-label={language.code === 'es' ? 'Español' : 'English'}
                    aria-current={language.code === locale ? 'page' : undefined}
                    class:list={[
                      'menu-link',
                      language.code === locale && 'font-bold',
                    ]}
                  >
                    {language.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </details>
  </nav>
</header>
